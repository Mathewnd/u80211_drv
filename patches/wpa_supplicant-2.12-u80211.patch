+static const u8 *u80211_get_mac_addr(void *priv)
+{
+	return ((struct u80211_driver_data *) priv)->own_addr;
+}
+
+static int u80211_get_bssid(void *priv, u8 *bssid)
+{
+	os_memcpy(bssid, ((struct u80211_driver_data *) priv)->bssid, ETH_ALEN);
+	return 0;
+}
