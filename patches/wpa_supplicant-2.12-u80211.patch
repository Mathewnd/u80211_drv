+	.name = "u80211",
+	.desc = "u80211 userspace driver over UNIX socket",
+	.init = u80211_init,
+	.deinit = u80211_deinit,
+	.get_capa = u80211_get_capa,
+	.get_mac_addr = u80211_get_mac_addr,
+	.get_bssid = u80211_get_bssid,
+	.get_ssid = u80211_get_ssid,
+	.set_key = u80211_set_key,
+	.scan2 = u80211_scan2,
+	.get_scan_results2 = u80211_get_scan_results2,
+	.associate = u80211_associate,
+	.deauthenticate = u80211_deauthenticate,
+};
