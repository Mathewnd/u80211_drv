+static int u80211_get_capa(void *priv, struct wpa_driver_capa *capa)
+{
+	(void) priv;
+	os_memset(capa, 0, sizeof(*capa));
+	capa->auth = WPA_DRIVER_AUTH_OPEN;
+	return 0;
+}
