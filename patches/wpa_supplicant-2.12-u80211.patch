+static int u80211_set_key(void *priv, struct wpa_driver_set_key_params *params)
+{
+	(void) priv;
+	/* Open networks never install keys; accept cleanup and reject all others. */
+	return params != NULL && params->alg == WPA_ALG_NONE ? 0 : -1;
+}
+
+static int u80211_scan2(void *priv, struct wpa_driver_scan_params *params)
+{
+	struct u80211_driver_data *drv = priv;
+	u8 *response = NULL;
+	size_t response_len = 0;
+
+	(void) params;
+	u80211_free_scan_results(drv);
+	if (u80211_request(drv, U80211_WPAS_REQUEST_SCAN, NULL, 0,
+			   &response, &response_len) < 0)
+		return -1;
+	if (response_len != 0) {
+		if (u80211_parse_scan_results(drv, response, response_len) < 0) {
+			os_free(response);
+			return -1;
+		}
+		os_free(response);
+		wpa_supplicant_event(drv->ctx, EVENT_SCAN_RESULTS, NULL);
+	}
+	return 0;
+}
+
+static struct wpa_scan_results *u80211_get_scan_results2(void *priv)
+{
+	struct u80211_driver_data *drv = priv;
+	u8 *response = NULL;
+	size_t response_len = 0;
+	struct wpa_scan_results *results;
+
+	if (drv->scan_results == NULL) {
+		if (u80211_request(drv, U80211_WPAS_REQUEST_GET_SCAN_RESULTS, NULL,
+				   0, &response, &response_len) < 0)
+			return NULL;
+		if (u80211_parse_scan_results(drv, response, response_len) < 0) {
+			os_free(response);
+			return NULL;
+		}
+		os_free(response);
+	}
+	results = drv->scan_results;
+	drv->scan_results = NULL;
+	return results;
+}
+
+static int u80211_associate(void *priv, struct wpa_driver_associate_params *params)
+{
+	struct u80211_driver_data *drv = priv;
+	u8 *request;
+	u8 *response = NULL;
+	size_t response_len = 0;
+
+	if (params == NULL || params->bssid == NULL ||
+		(params->wpa_ie_len != 0 && params->wpa_ie == NULL) ||
+		(params->ssid_len != 0 && params->ssid == NULL) ||
+		params->wpa_ie_len > UINT16_MAX || params->ssid_len > sizeof(drv->ssid))
+		return -1;
+	os_memcpy(drv->bssid, params->bssid, ETH_ALEN);
+	drv->ssid_len = params->ssid_len;
+	if (drv->ssid_len != 0)
+		os_memcpy(drv->ssid, params->ssid, drv->ssid_len);
+	request = os_zalloc(sizeof(u80211_wpas_associate_t) + params->wpa_ie_len);
+	if (request == NULL)
+		return -1;
+	os_memcpy(request, params->bssid, ETH_ALEN);
+	u80211_put_le16(request + 6, params->wpa_ie_len);
+	if (params->wpa_ie_len != 0)
+		os_memcpy(request + sizeof(u80211_wpas_associate_t), params->wpa_ie,
+			  params->wpa_ie_len);
+	int status = u80211_request(drv, U80211_WPAS_REQUEST_ASSOCIATE, request,
+				    sizeof(u80211_wpas_associate_t) + params->wpa_ie_len,
+				    &response, &response_len);
+	os_free(request);
+	if (status < 0)
+		return -1;
+	os_free(response);
+	return 0;
+}
+
+static int u80211_deauthenticate(void *priv, const u8 *addr, u16 reason_code)
+{
+	struct u80211_driver_data *drv = priv;
+	u8 *response = NULL;
+	size_t response_len = 0;
+
+	(void) addr;
+	(void) reason_code;
+	if (u80211_request(drv, U80211_WPAS_REQUEST_DISASSOCIATE, NULL, 0,
+			   &response, &response_len) < 0)
+		return -1;
+	os_free(response);
+	return 0;
+}
+
